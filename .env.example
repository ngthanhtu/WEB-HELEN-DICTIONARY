ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
MW_LEARNERS_KEY=
MW_DAILY_REQUEST_LIMIT=950
# Optional: shared by AI contexts, translation fallback, and iPhone microphone transcription.
GEMINI_API_KEY=
# Optional explicit model; blank lets the server handle a retired default model.
GEMINI_MODEL=
# Production budgets, shared across all users; cache hits don't spend these budgets.
# Keep below your provider allowance. Reserved attempts may include a failed call.
TTS_DAILY_CHARACTER_LIMIT=2000
TTS_MONTHLY_CHARACTER_LIMIT=9000
TTS_DEVICE_DAILY_CHARACTER_LIMIT=750
AI_DAILY_REQUEST_LIMIT=100
PORT=3000

# Optional durable MySQL/TiDB database. Real credentials belong in Render Environment or .env.
MYSQL_HOST=
MYSQL_PORT=4000
MYSQL_DATABASE=helen_dictionary
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=true
# Optional trusted CA PEM or a local file path when the provider requires a private CA.
MYSQL_SSL_CA=
MYSQL_SSL_CA_FILE=
# Alternative: mysql://user:encoded-password@host:port/database
DATABASE_URL=
