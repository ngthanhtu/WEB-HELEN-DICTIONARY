ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
MW_LEARNERS_KEY=
MW_DAILY_REQUEST_LIMIT=950
# Optional: shared by AI contexts, translation fallback, and iPhone microphone transcription.
GEMINI_API_KEY=
# Optional explicit model; blank lets the server handle a retired default model.
GEMINI_MODEL=
# Production budgets, shared across all users; cache hits don't spend these budgets.
# Keep below your provider allowance. Reserved attempts may include a failed call.
TTS_DAILY_CHARACTER_LIMIT=2000
TTS_MONTHLY_CHARACTER_LIMIT=9000
TTS_DEVICE_DAILY_CHARACTER_LIMIT=750
# Independent server-derived IP/network limits also apply when a client changes device IDs.
TTS_IP_DAILY_CHARACTER_LIMIT=1500
AI_DAILY_REQUEST_LIMIT=100
# Separate speaking budget: 100 replies + up to 200 transcription attempts/device/day (one bounded retry per long recording).
# Both consume the shared 600-generation speaking allowance. UTC reset; provider caps still apply.
PRACTICAL_DEVICE_DAILY_REPLY_LIMIT=100
PRACTICAL_DEVICE_DAILY_TRANSCRIPTION_LIMIT=200
PRACTICAL_DAILY_GENERATION_LIMIT=600
PRACTICAL_IP_DAILY_REPLY_LIMIT=300
PRACTICAL_IP_DAILY_TRANSCRIPTION_LIMIT=600
PRACTICAL_IP_DAILY_ASSESSMENT_LIMIT=30
HISTORY_DAILY_EVENT_LIMIT=100000
HISTORY_DEVICE_DAILY_EVENT_LIMIT=500
HISTORY_IP_DAILY_EVENT_LIMIT=2000
# Optional stable secret for hashing networks. Blank uses the existing server provider key.
ABUSE_LIMIT_SECRET=
PORT=3000

# Optional durable MySQL/TiDB database. Real credentials belong in Render Environment or .env.
MYSQL_HOST=
MYSQL_PORT=4000
MYSQL_DATABASE=helen_dictionary
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=true
# Set false after an administrator creates all tables and a runtime-only database user.
# Explicit npm run db:migrate still creates tables with separate provisioning credentials.
DATABASE_AUTO_MIGRATE=true
# Optional trusted CA PEM or a local file path when the provider requires a private CA.
MYSQL_SSL_CA=
MYSQL_SSL_CA_FILE=
# Alternative: mysql://user:encoded-password@host:port/database
DATABASE_URL=

# IELTS session reports have a separate device allowance; keep 100 replies intact.
PRACTICAL_DEVICE_DAILY_ASSESSMENT_LIMIT=10
